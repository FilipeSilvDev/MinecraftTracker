<Window
    x:Class="TrackerGames.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="#06080D">

        <Grid.Resources>
            <!-- Paleta de Cores Minimalista Gamer -->
            <SolidColorBrush x:Key="BgBrush" Color="#06080D" />
            <SolidColorBrush x:Key="PaneBrush" Color="#0B0F19" />
            <SolidColorBrush x:Key="CardBrush" Color="#111726" />
            <SolidColorBrush x:Key="CardBrushAlt" Color="#161E30" />
            <SolidColorBrush x:Key="BorderBrush1" Color="#1F2A40" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#00E676" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

            <!-- Estilos Base -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="24" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="25" />
            </Style>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>

            <Style x:Key="NavIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="18" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BARRA DE TÍTULO -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="20,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="Transparent">
                    <Image Source="/Assets/Icones/trackstats-icone.png" />
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" CharacterSpacing="20">
                    <Run Text="TRACKER" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text="GAMES" Foreground="{StaticResource AccentGreenBrush}" />
                </TextBlock>
                <Rectangle Width="1" Height="14" Fill="{StaticResource BorderBrush1}" Margin="8,0" />
                <TextBlock Text="MINECRAFT" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" CharacterSpacing="50" />
            </StackPanel>
        </Grid>

        <!-- NAVEGAÇÃO -->
        <NavigationView x:Name="MainNav"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="220"
                        PaneDisplayMode="LeftCompact"
                        Background="Transparent"
                        SelectionChanged="MainNav_SelectionChanged">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0B0F19" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#00E676" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" IsSelected="True" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Estatísticas" Tag="stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Ajustes" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- CONTEÚDO PRINCIPAL -->
            <ScrollViewer Padding="32" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="24">

                    <!-- HERO: Perfil do Jogo -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="80" Height="80" CornerRadius="20" Background="{StaticResource CardBrushAlt}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" Margin="0,0,24,0">
                            <Image Source="/Assets/Icones/minecraft-modern-icon.png" Width="48" Height="48" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="Minecraft Java Edition" Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left">
                                Monitoramento em tempo real. O Tracker Games detecta a execução em segundo plano e registra suas métricas de sessão automaticamente.
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- PAINEL DA SESSÃO ATUAL -->
                    <Border Style="{StaticResource CardStyle}" Background="{StaticResource PaneBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="12">
                                <TextBlock Text="STATUS DO SISTEMA" Style="{StaticResource LabelStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Background="{StaticResource CardBrushAlt}" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding StatusGlyph}" FontSize="12" Foreground="{Binding StatusBrush}" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE916;" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="Captura Automática Ativa" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Timer -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="TEMPO DA SESSÃO" Style="{StaticResource LabelStyle}" HorizontalAlignment="Right" Margin="0,0,0,4" />
                                <TextBlock x:Name="CurrentSessionTimeText"
                                           Text="{Binding RunningGameTime}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           FontFamily="Consolas"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CARDS DE ESTATÍSTICAS -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Total Playtime -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{StaticResource CardBrushAlt}" CornerRadius="6" Padding="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="TEMPO TOTAL JOGADO" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding TotalPlayTime}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Today Playtime -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{StaticResource CardBrushAlt}" CornerRadius="6" Padding="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE787;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <TextBlock Text="JOGADO HOJE" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding TodayPlayTime}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- HISTÓRICO DE SESSÕES -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="20">
                            <TextBlock Text="HISTÓRICO RECENTE" Style="{StaticResource SectionTitleStyle}" />

                            <ListView ItemsSource="{Binding RecentSessions}" SelectionMode="None" Background="Transparent">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="4,12,4,12">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="{Binding DateFormatted}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding StartTimeFormatted}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock Text="—" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding EndTimeFormatted}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{StaticResource CardBrushAlt}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DurationFormatted}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentGreenBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>