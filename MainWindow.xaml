<Window
    x:Class="MinecraftTracker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource BgBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ BARRA DE TÍTULO CUSTOMIZADA ============  -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{ThemeResource PaneBrush}"
                BorderBrush="{ThemeResource BorderBrush1}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold">
                    <Run Text="Minecraft " Foreground="{ThemeResource TitleBarForegroundBrush}" />
                    <Run Text="Tracker" Foreground="{ThemeResource AccentGreenBrush}" />
                </TextBlock>
                <Rectangle Width="1" Height="16" Fill="{ThemeResource BorderBrush1}" Margin="4,0" />
                <!--  TODO: tornar dinâmico e refletir o jogo detectado  -->
                <TextBlock Text="Minecraft" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!--  ============ NAVIGATIONVIEW (SHELL PRINCIPAL) ============  -->
        <NavigationView x:Name="MainNav"
                         Grid.Row="1"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         IsTitleBarAutoPaddingEnabled="False"
                         OpenPaneLength="230"
                         CompactPaneLength="56"
                         PaneDisplayMode="LeftCompact"
                         Background="{ThemeResource BgBrush}"
                         SelectionChanged="MainNav_SelectionChanged">

            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="Themes/ColorPalette.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                    <ThemeResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="PaneBrush" />
                    <ThemeResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="AccentGreenBrush" />
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Content="Início" IsSelected="True" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GamesNavItem" Content="Jogos" Tag="games">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="StatsNavItem" Content="Estatísticas" Tag="stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="Configurações" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,12,12,16">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{ThemeResource CardBrushAlt}">
                        <Image Source="ms-appx:///Assets/Icones/minecraft-modern-icon.png" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MinecraftTracker" Foreground="{ThemeResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Acompanhe seu tempo de jogo." Foreground="{ThemeResource TextMutedBrush}" FontSize="10" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!--  ============ ÁREA DE CONTEÚDO (troca de página em tempo real) ============  -->
            <Frame x:Name="ContentFrame" />

        </NavigationView>
    </Grid>
</Window>
