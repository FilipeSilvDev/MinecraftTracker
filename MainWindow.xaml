<Window
    x:Class="MinecraftTracker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="#FF1E1E1E">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ BARRA DE TÍTULO CUSTOMIZADA ============  -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="#FF252525"
                BorderBrush="#FF2A2A2A"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold">
                    <Run Text="Minecraft " Foreground="#FFFFFFFF" />
                    <Run Text="Tracker" Foreground="#FF4CAF50" />
                </TextBlock>
                <Rectangle Width="1" Height="16" Fill="#FF2A2A2A" Margin="4,0" />
                <!--  TODO: tornar dinâmico e refletir o jogo detectado  -->
                <TextBlock Text="Minecraft" Foreground="#FFBDBDBD" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!--  ============ NAVIGATIONVIEW (SHELL PRINCIPAL) ============  -->
        <NavigationView x:Name="MainNav"
                         Grid.Row="1"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         IsTitleBarAutoPaddingEnabled="False"
                         OpenPaneLength="230"
                         CompactPaneLength="56"
                         PaneDisplayMode="LeftCompact"
                         Background="#FF1E1E1E"
                         SelectionChanged="MainNav_SelectionChanged">

            <NavigationView.Resources>
                <ResourceDictionary>
                    <Style x:Key="NavIconStyle" TargetType="FontIcon">
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="Foreground" Value="#FFBDBDBD" />
                    </Style>
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF252525" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF4CAF50" />
                </ResourceDictionary>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Content="Início" IsSelected="True" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="StatsNavItem" Content="Estatísticas" Tag="stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="Configurações" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource NavIconStyle}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,12,12,16">
                    <Border Width="36" Height="36" CornerRadius="9" Background="#FF2B2B2B">
                        <Image Source="ms-appx:///Assets/Icones/MinecraftTracker_icone.png" Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MinecraftTracker" Foreground="#FFFFFFFF" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Acompanhe seu tempo de jogo." Foreground="#FF9E9E9E" FontSize="10" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!--  ============ ÁREA DE CONTEÚDO (troca de página em tempo real) ============  -->
            <Frame x:Name="ContentFrame" />

        </NavigationView>
    </Grid>
</Window>
