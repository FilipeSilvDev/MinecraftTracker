<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ===== Paleta com suporte a tema claro / escuro =====
        As chaves abaixo (BgBrush, CardBrush, etc.) são resolvidas automaticamente
        pelo WinUI de acordo com o tema atual (Light, Dark ou o padrão do Windows),
        desde que sejam usadas com {ThemeResource NomeDaChave} em vez de {StaticResource}.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <!--  ===== Tema Escuro (padrão anterior, refinado) =====  -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgBrush" Color="#0A0D14" />
            <SolidColorBrush x:Key="PaneBrush" Color="#0D1119" />
            <SolidColorBrush x:Key="CardBrush" Color="#11161F" />
            <SolidColorBrush x:Key="CardBrushAlt" Color="#161C27" />
            <SolidColorBrush x:Key="BorderBrush1" Color="#232B3A" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#2ECC71" />
            <SolidColorBrush x:Key="AccentGreenDimBrush" Color="#173C29" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="AccentBlueBrush" Color="#4C9BFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5FA" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B95A7" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#5B6577" />
            <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#F2F5FA" />
        </ResourceDictionary>

        <!--  ===== Tema Claro =====  -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgBrush" Color="#F4F6F9" />
            <SolidColorBrush x:Key="PaneBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBrushAlt" Color="#EEF1F5" />
            <SolidColorBrush x:Key="BorderBrush1" Color="#E1E5EB" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#1E9E56" />
            <SolidColorBrush x:Key="AccentGreenDimBrush" Color="#DEF5E7" />
            <SolidColorBrush x:Key="AccentRedBrush" Color="#D93A3E" />
            <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#171A21" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#55606E" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8A93A1" />
            <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#171A21" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--  ===== Estilos compartilhados (usam as cores acima, adaptam-se ao tema) =====  -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="EyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="MonoValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="NavIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="AccentBarStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="16" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="Fill" Value="{ThemeResource AccentGreenBrush}" />
    </Style>

    <!--  Título e subtítulo padrão de cada página (Início / Estatísticas / Configurações)  -->
    <Style x:Key="PageHeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="PageHeaderSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Rótulo de uma linha de configuração (título + descrição à esquerda)  -->
    <Style x:Key="SettingRowTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="SettingRowDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Botão de ação destrutiva (ex.: limpar histórico)  -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentRedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource AccentRedBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!--  Item de sessão do histórico (data + intervalo + duração)  -->
    <DataTemplate x:Key="SessionItemTemplate">
        <Border BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="2,14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="{ThemeResource CardBrushAlt}">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE787;"
                              FontSize="14"
                              Foreground="{ThemeResource AccentGreenBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{Binding DateFormatted}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding StartTimeFormatted}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock Text="&#8594;" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{Binding EndTimeFormatted}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding DurationFormatted}"
                           FontFamily="Consolas"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{ThemeResource AccentGreenBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>

    <!--  Barra do gráfico "Últimos 7 dias" da página de Estatísticas  -->
    <DataTemplate x:Key="DayBarTemplate">
        <Grid Width="52" Height="160">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Width="22"
                    Height="{Binding BarHeight}"
                    CornerRadius="6"
                    Background="{ThemeResource AccentGreenBrush}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="{Binding MinutesFormatted}" />

            <TextBlock Grid.Row="1"
                       Text="{Binding DayLabel}"
                       FontSize="12"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>

