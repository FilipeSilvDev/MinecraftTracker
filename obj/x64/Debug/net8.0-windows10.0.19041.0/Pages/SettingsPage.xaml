<Page
    x:Class="MinecraftTracker.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource BgBrush}">

    <ScrollViewer Padding="40,32,40,40" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="24">

            <!--  Cabeçalho da página  -->
            <StackPanel Spacing="4">
                <TextBlock Text="Configurações" Style="{StaticResource PageHeaderTitleStyle}" />
                <TextBlock Text="Personalize a aparência e o comportamento do MinecraftTracker." Style="{StaticResource PageHeaderSubtitleStyle}" />
            </StackPanel>

            <!--  ===== Aparência ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Rectangle Style="{StaticResource AccentBarStyle}" />
                        <TextBlock Text="Aparência" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Tema do aplicativo" Style="{StaticResource SettingRowTitleStyle}" />
                            <TextBlock Text="Escolha entre claro, escuro ou siga o padrão do Windows." Style="{StaticResource SettingRowDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:ConnectionId='5' Grid.Column="1"
                                  x:Name="ThemeComboBox"
                                  Width="190"
                                  VerticalAlignment="Center"
                                                                                   >
                            <ComboBoxItem Content="Padrão do Windows" Tag="System" />
                            <ComboBoxItem Content="Claro" Tag="Light" />
                            <ComboBoxItem Content="Escuro" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== Comportamento ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Rectangle Style="{StaticResource AccentBarStyle}" />
                        <TextBlock Text="Comportamento" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Tocar som ao iniciar" Style="{StaticResource SettingRowTitleStyle}" />
                            <TextBlock Text="Reproduz um efeito sonoro sempre que o MinecraftTracker é aberto." Style="{StaticResource SettingRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='4' Grid.Column="1"
                                      x:Name="StartupSoundToggle"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"
                                                                           />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Iniciar com o Windows" Style="{StaticResource SettingRowTitleStyle}" />
                            <TextBlock Text="Abre o app automaticamente ao ligar o computador." Style="{StaticResource SettingRowDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='3' Grid.Column="1"
                                      x:Name="StartWithWindowsToggle"
                                      OnContent=""
                                      OffContent=""
                                      VerticalAlignment="Center"
                                                                               />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== Dados ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Rectangle Style="{StaticResource AccentBarStyle}" />
                        <TextBlock Text="Dados" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Histórico de sessões" Style="{StaticResource SettingRowTitleStyle}" />
                            <TextBlock Text="Remove permanentemente todas as sessões salvas no banco local." Style="{StaticResource SettingRowDescriptionStyle}" />
                        </StackPanel>
                        <Button x:ConnectionId='2' Grid.Column="1"
                                Content="Limpar histórico"
                                Style="{StaticResource DangerButtonStyle}"
                                VerticalAlignment="Center"
                                                                 />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  ===== Sobre ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource CardBrushAlt}">
                        <Image Source="ms-appx:///Assets/Icones/MinecraftTracker_icone.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="MinecraftTracker" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="Versão 1.0.0" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

