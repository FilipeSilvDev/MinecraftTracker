<Page
    x:Class="MinecraftTracker.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource BgBrush}">

    <ScrollViewer Padding="40,32,40,40" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Spacing="24">

            <!--  Cabeçalho do jogo  -->
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16" Background="{ThemeResource CardBrushAlt}" BorderBrush="{ThemeResource BorderBrush1}" BorderThickness="1">
                    <Image Source="ms-appx:///Assets/Icones/minecraft-modern-icon.png" Width="62" Height="62" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Minecraft" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="620">
                        Acompanhe o tempo de jogo automaticamente. O Minecraft Tracker detecta quando o jogo está em execução e inicia a contagem.
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!--  Card em destaque: Sessão atual  -->
            <Border Background="{ThemeResource CardBrush}"
                    BorderBrush="{Binding StatusBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="26,22">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Style="{StaticResource AccentBarStyle}" />
                            <TextBlock Text="STATUS DO JOGO" Style="{StaticResource EyebrowStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="46" Height="46" CornerRadius="11" Background="{ThemeResource CardBrushAlt}">
                                <Image Source="ms-appx:///Assets/Icones/minecraft_icone_javaedition.png" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="Minecraft Java Edition" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <Border BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{Binding StatusGlyph}" FontSize="10" Foreground="{Binding StatusBrush}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Medium" Foreground="{Binding StatusBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!--  Temporizador da sessão atual  -->
                    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="TEMPO DESTA SESSÃO" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Right" />
                        <TextBlock x:ConnectionId='3' x:Name="CurrentSessionTimeText"
                                   Text="{Binding RunningGameTime}"
                                   Foreground="{Binding StatusBrush}"
                                   FontFamily="Consolas"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Estatísticas rápidas  -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="11" Background="{ThemeResource CardBrushAlt}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" FontSize="18" Foreground="{ThemeResource AccentGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Tempo total jogado" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding TotalPlayTime}" Style="{StaticResource MonoValueStyle}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border Width="44" Height="44" CornerRadius="11" Background="{ThemeResource CardBrushAlt}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE787;" FontSize="18" Foreground="{ThemeResource AccentGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Jogado hoje" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{Binding TodayPlayTime}" Style="{StaticResource MonoValueStyle}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Histórico de sessões  -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Rectangle Style="{StaticResource AccentBarStyle}" />
                            <TextBlock Text="Histórico de Sessões" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <Button x:ConnectionId='2' Grid.Column="1"
                                x:Name="ClearHistoryButton"
                                Content="Limpar histórico"
                                Style="{StaticResource DangerButtonStyle}"
                                                                 />
                    </Grid>

                    <ListView ItemsSource="{Binding RecentSessions}"
                              ItemTemplate="{StaticResource SessionItemTemplate}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

