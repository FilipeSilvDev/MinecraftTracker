<Page
    x:Class="MinecraftTracker.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource BgBrush}">

    <Page.Resources>
        <DataTemplate x:Key="GameCardTemplate">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="20">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="{ThemeResource CardBrushAlt}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE768;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentGreenBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ProcessName}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:ConnectionId='3' Content="Iniciar" Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding}"                            />
                        <Button x:ConnectionId='4' Content="Remover" Style="{StaticResource DangerButtonStyle}" Tag="{Binding}"                            />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="40,32,40,40" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Spacing="24">

            <!--  Cabeçalho + botão adicionar  -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Jogos" Style="{StaticResource PageHeaderTitleStyle}" />
                    <TextBlock Text="Adicione atalhos para abrir e monitorar seus jogos direto por aqui." Style="{StaticResource PageHeaderSubtitleStyle}" />
                </StackPanel>
                <Button x:ConnectionId='7' Grid.Column="1"
                        x:Name="AddGameButton"
                        Content="+ Adicionar jogo"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center"
                                                    />
            </Grid>

            <!--  Lista de atalhos cadastrados  -->
            <ItemsControl x:ConnectionId='5' x:Name="GamesListView" ItemTemplate="{StaticResource GameCardTemplate}" />

            <!--  Estado vazio  -->
            <Border x:ConnectionId='6' x:Name="EmptyStateBorder" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="0,20">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;" FontSize="28" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum jogo cadastrado ainda" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Clique em &quot;+ Adicionar jogo&quot; para começar." FontSize="12" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

