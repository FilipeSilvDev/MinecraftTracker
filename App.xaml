<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MinecraftTracker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MinecraftTracker">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Recursos-base carregados antes dos estilos dependentes. -->
                <ResourceDictionary Source="ms-appx:///Themes/BaseResources.xaml" />
                <!-- Tornar Themes/ColorPalette.xaml disponível globalmente -->
                <ResourceDictionary Source="ms-appx:///Themes/ColorPalette.xaml" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <SolidColorBrush x:Key="TabViewButtonBackground" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#FF383838" />
            <SolidColorBrush x:Key="TabViewButtonBackgroundPressed" Color="#FF454545" />
            <SolidColorBrush x:Key="TabViewButtonBackgroundSelected" Color="#FF333333" />
            <SolidColorBrush x:Key="BgBrush" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="PaneBrush" Color="#FF252525" />
            <SolidColorBrush x:Key="BorderBrush1" Color="#FF2A2A2A" />
            <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF4CAF50" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFBDBDBD" />
            <SolidColorBrush x:Key="CardBrushAlt" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#FF9E9E9E" />
            <Style x:Key="NavIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
